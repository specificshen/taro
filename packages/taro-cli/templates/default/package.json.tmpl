{
  "name": "{{ projectName }}",
  "version": "1.0.0",
  "private": true,
  "description": "{{ description }}",
  "templateInfo": {
    "name": "{{ template }}",
    "typescript": {{ typescript }},
    "css": "{{ css }}",
    "framework": "{{ framework }}"
  },
  "scripts": {
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch"
  },
  {{#if buildEs5 }}
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  {{else}}
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  {{/if}}
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "{{ version }}",
    "@tarojs/helper": "{{ version }}",
    "@tarojs/plugin-platform-weapp": "{{ version }}",
    "@tarojs/plugin-framework-react": "{{ version }}",
    "@tarojs/runtime": "{{ version }}",
    "@tarojs/shared": "{{ version }}",
    "@tarojs/taro": "{{ version }}",
    "@tarojs/react": "{{ version }}",
    "react-dom": "^19.2.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@tarojs/plugin-generator": "{{ version }}",
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@tarojs/cli": "{{ version }}",
    "@tarojs/vite-runner": "{{ version }}",
    "babel-preset-taro": "{{ version }}",
    "terser": "^5.30.4",
    "vite": "^8.0.13",
    "@babel/preset-react": "^7.24.1",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.2",{{#if (eq css "Sass") }}
    "sass": "^1.75.0",{{/if}}{{#if (eq css "Less") }}
    "less": "^4.2.0",{{/if}}{{#if (eq css "Stylus") }}
    "stylus": "^0.63.0",{{/if}}{{#if typescript }}
    "typescript": "^5.4.5",{{/if}}
    "postcss": "^8.5.6",
    "@types/minimatch": "^5"
  }
}
